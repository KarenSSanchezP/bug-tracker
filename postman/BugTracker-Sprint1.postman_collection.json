      "name": "CP-01 Crear bug válido",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', ()=>pm.response.to.have.status(201));",
              "const b=pm.response.json();",
              "pm.test('Estado ABIERTO',()=>pm.expect(b.estado).to.eql('ABIERTO'));",
              "pm.test('Tiene id y fecha',()=>{pm.expect(b.id).to.exist;pm.expect(b.fechaCreacion).to.exist;});",
              "pm.collectionVariables.set('ultimoId',b.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bugs",
        "body": {
          "mode": "raw",
          "raw": "{\"titulo\": \"Error en login\", \"descripcion\": \"No deja entrar con datos válidos\", \"prioridad\": \"ALTA\", \"severidad\": \"MEDIA\"}"
        }
