    {
      "name": "CP-21/22/23 Listar bugs (orden y campos)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200',()=>pm.response.to.have.status(200));",
              "const l=pm.response.json();",
              "pm.test('Es lista',()=>pm.expect(l).to.be.an('array'));",
              "pm.test('Campos',()=>l.forEach(b=>pm.expect(b).to.include.keys('id','titulo','estado','prioridad','fechaCreacion')));",
              "pm.test('Más recientes primero',()=>{for(let i=1;i<l.length;i++)pm.expect(new Date(l[i-1].fechaCreacion)>=new Date(l[i].fechaCreacion)).to.be.true;});",
              "pm.test('Último creado aparece primero',()=>pm.expect(l[0].id).to.eql(pm.collectionVariables.get('ultimoId')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/bugs"
      }
    }
